# --- HDFS & File System Paths ---
# Where the data sits in your local container/machine
LOCAL_SOURCE=/opt/airflow/data

# Where the data will be moved in HDFS
HDFS_RAW=/uber/data/raw

# Path to the HDFS binary (depends on your Hadoop installation)
HADOOP_BIN=/usr/local/hadoop/bin/hdfs

# Pattern to filter files (e.g., NYC Uber parquet files)
FILE_PATTERN=*_tripdata_*.parquet